#include <behaviors/battery_percentage_printer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&gresc {
    bindings = <&kp UNDERSCORE>, <&kp MINUS>;
};

/ {
    combos {
        compatible = "zmk,combos";

        quick_left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        quick_closing_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
        };

        quick_open_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
        };

        quick_closing_bracket-brace {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <32 33>;
        };

        quick_underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <36 53>;
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW";
        };

        scope: scope {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "SCOPE";
        };

        not_equal: not_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_EQUAL";
        };

        gre: gre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GRE";
        };

        lse: lse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LSE";
        };

        git_status: git_status {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp S &kp T &kp A &kp T &kp U &kp S>;
            label = "GIT_STATUS";
        };

        git_add: git_add {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp A &kp D &kp D &kp SPACE>;
            label = "GIT_ADD";
        };

        git_commit: git_commit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp C &kp O &kp M &kp M &kp I &kp T &kp SPACE &kp MINUS &kp M &kp SPACE &kp DQT &kp DQT &kp LEFT>;
            label = "GIT_COMMIT";
        };

        git_push: git_push {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp S &kp H>;
            label = "GIT_PUSH";
        };

        colcon: colcon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp L &kp C &kp O &kp N &kp SPACE &kp B &kp U &kp I &kp L &kp D &kp SPACE &kp MINUS &kp MINUS &kp S &kp Y &kp M &kp L &kp I &kp N &kp K &kp MINUS &kp I &kp N &kp S &kp T &kp A &kp L &kp L>;
            label = "COLCON";
        };

        source: source {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp O &kp U &kp R &kp C &kp E &kp SPACE &kp I &kp N &kp S &kp T &kp A &kp L &kp L &kp FSLH &kp S &kp E &kp T &kp U &kp P &kp DOT &kp B &kp A &kp S &kp H>;
            label = "SOURCE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp GRAVE     &kp N1  &kp N2  &kp N3  &kp N4     &kp N5                                               &kp N6      &kp N7           &kp N8     &kp N9   &kp N0               &kp EQUAL
&kp TAB       &kp Q   &kp W   &kp E   &kp R      &kp T                                                &kp Y       &kp U            &kp I      &kp O    &kp P                &gresc
&kp CAPSLOCK  &kp A   &kp S   &kp D   &kp F      &kp G                                                &kp H       &kp J            &kp K      &kp L    &kp SEMI             &kp SQT
&kp LSHFT     &kp Z   &kp X   &kp C   &kp V      &kp B         &kp ESC                 &kp ENTER      &kp N       &kp M            &kp COMMA  &kp DOT  &mt BACKSLASH SLASH  &kp LEFT_WIN
                              &mo 1   &kp LCTRL  &kp LEFT_ALT  &mt LEFT_SHIFT SPACE    &kp BACKSPACE  &kp DELETE  &kp PRINTSCREEN  &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &kp F1         &kp F2         &kp F3            &kp F4     &kp F5                       &kp F6          &kp F7             &kp F8           &kp F9      &kp F10               &kp F11
&trans  &arrow         &scope         &not_equal        &lse       &gre                         &kp HOME        &kp PAGE_DOWN      &kp PAGE_UP      &kp END     &kp C_BRIGHTNESS_INC  &kp F12
&trans  &git_status    &git_add       &git_commit       &git_push  &colcon                      &kp LEFT        &kp DOWN           &kp UP_ARROW     &kp RIGHT   &kp C_BRIGHTNESS_DEC  &trans
&trans  &kp LC(LS(P))  &kp LS(LA(A))  &kp LS(LA(DOWN))  &kp LC(Z)  &kp LC(V)  &trans    &trans  &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &kp C_PAUSE           &trans
                                      &trans            &trans     &trans     &trans    &trans  &trans          &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&bapp   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bapp
&trans  &kp A         &kp A         &kp A         &kp A         &kp A                           &kp A          &kp A          &kp A          &kp A          &kp A          &trans
&trans  &kp A         &kp A         &kp A         &kp A         &kp A                           &kp A          &kp A          &kp A          &kp A          &kp A          &trans
&trans  &kp A         &kp A         &kp A         &kp A         &kp A         &trans    &trans  &kp A          &kp A          &kp A          &kp A          &kp A          &trans
                                    &trans        &trans        &trans        &trans    &trans  &trans         &trans         &trans
            >;
        };
    };
};
